{
  "name": "mirror",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "check": "tsc -p . && eslint . && node --test mirror-pi/evals/contracts/",
    "test": "node --test mirror-pi/evals/contracts/",
    "test:integration": "node --test --test-concurrency=1 mirror-pi/evals/integration/",
    "test:mutants": "node mirror-pi/evals/mutants.ts --integration",
    "test:behavior": "node --test --test-concurrency=1 mirror-pi/evals/behavior/"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "typebox": "1.4.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "pi": {
    "extensions": [
      "./mirror-pi/extensions/instructions.ts",
      "./mirror-pi/extensions/journeys.ts",
      "./mirror-pi/extensions/journal.ts",
      "./mirror-pi/extensions/corrections.ts",
      "./mirror-pi/extensions/identity.ts"
    ]
  }
}
